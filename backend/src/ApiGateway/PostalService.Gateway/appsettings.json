{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "postoffices": {
        "ClusterId": "postoffices",
        "Match": { "Path": "/api/postoffices/{**catch-all}" }
      },
      "shipments": {
        "ClusterId": "shipments",
        "Match": { "Path": "/api/shipments/{**catch-all}" }
      },
      "tracking": {
        "ClusterId": "shipments",
        "Match": { "Path": "/api/tracking/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:02", "Path": "/health/ready" }
        },
        "Destinations": {
          "identity-1": { "Address": "http://localhost:5101/" }
        }
      },
      "postoffices": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:02", "Path": "/health/ready" }
        },
        "Destinations": {
          "postoffices-1": { "Address": "http://localhost:5102/" }
        }
      },
      "shipments": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:02", "Path": "/health/ready" }
        },
        "Destinations": {
          "shipments-1": { "Address": "http://localhost:5103/" }
        }
      }
    }
  }
}
